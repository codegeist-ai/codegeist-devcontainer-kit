#!/usr/bin/env bash
# oc - start OpenCode in a persistent tmux terminal
#
# Inputs:
# - All arguments are forwarded to OpenCode after the fixed `--auto -c` flags.
# - TMUX selects a new window in the current session instead of nesting tmux.
#
# Side effects:
# - Creates a new attached tmux session outside tmux, or a new window inside it.
# - Enables application-originated OSC 52 clipboard updates for the tmux server
#   so OpenCode's TUI copy action reaches the outer terminal clipboard.
# - Binds tmux Prefix + R and direct Alt + R to toggle the workspace microphone
#   recorder.
# - Selects the logging Bash wrapper for OpenCode tool shells; see
#   README.md#opencode-in-tmux for the mandatory metadata log contract.
# - Selects the container's shared HTTP proxy and mitmproxy-generated CA; see
#   README.md#opencode-http-logging for coverage and startup configuration.
#
# Related files:
# - ../Dockerfile.base
# - ../tests/opencode-tmux-wrapper.sh

set -euo pipefail

proxy=http://127.0.0.1:18080
ca_cert="$DEVCONTAINER_WORKSPACE_FOLDER/.tmp/opencode-http/mitmproxy-ca-cert.pem"
bypass="localhost,127.0.0.1,::1${NO_PROXY:+,$NO_PROXY}${no_proxy:+,$no_proxy}"
# Pass values to the pane command explicitly: an existing tmux server does not
# automatically inherit the environment of a later oc invocation.
opencode_env=(
  "HTTP_PROXY=$proxy" "HTTPS_PROXY=$proxy" "http_proxy=$proxy" "https_proxy=$proxy"
  "NO_PROXY=$bypass" "no_proxy=$bypass"
  "NODE_EXTRA_CA_CERTS=$ca_cert" "SSL_CERT_FILE=$ca_cert"
  "CURL_CA_BUNDLE=$ca_cert" "REQUESTS_CA_BUNDLE=$ca_cert" "GIT_SSL_CAINFO=$ca_cert"
  SHELL=/usr/local/lib/oc-shell/bash
)

if [ -n "${TMUX:-}" ]; then
  tmux set-option -s set-clipboard on
  tmux bind-key R run-shell -b 'oc-record "#{pane_id}"'
  tmux bind-key -n M-r run-shell -b 'oc-record "#{pane_id}"'
  exec tmux new-window -c "$PWD" env "${opencode_env[@]}" opencode --auto -c "$@"
fi

exec tmux start-server \; set-option -s set-clipboard on \; \
  bind-key R run-shell -b 'oc-record "#{pane_id}"' \; \
  bind-key -n M-r run-shell -b 'oc-record "#{pane_id}"' \; \
  new-session -c "$PWD" env "${opencode_env[@]}" opencode --auto -c "$@"
