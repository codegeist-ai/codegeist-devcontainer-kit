#!/usr/bin/env bash
# oc-record - toggle microphone recording for the current devcontainer workspace
#
# Inputs:
# - DEVCONTAINER_WORKSPACE_FOLDER is the guaranteed workspace root.
# - OC_RECORD_LANGUAGE optionally selects the whisper.cpp language; unset or
#   empty values preserve automatic detection.
# - One tmux pane target receives start, stop, and failure messages.
#
# Side effects:
# - Records the fixed forwarded Pulse source to `.tmp/recordings/`.
# - Downloads the multilingual Whisper small model to `/tmp` when absent, writes
#   a TXT transcript beside each finalized WAV, and inserts non-empty text into
#   the invoking pane without submitting it.
# - Shows a yellow tmux status bar while recording and restores its prior style.
# - Keeps workspace-local process, style, lock, and diagnostic state.
#
# Related files:
# - ../docs/tasks/T010_add_ssh_forwarded_tmux_recording/tasks/T010_02_add_microphone_recorder.md
# - ../docs/tasks/T011_transcribe_recordings_with_whisper_cpp.md
# - ../docs/tasks/T012_insert_transcript_into_opencode_input.md
# - ../tests/oc-record.sh

set -euo pipefail
umask 077

[ "$#" -eq 1 ] || {
  printf 'Usage: oc-record <tmux-pane>\n' >&2
  exit 2
}

pane="$1"
recording_dir="$DEVCONTAINER_WORKSPACE_FOLDER/.tmp/recordings"
state_file="$recording_dir/.oc-record.state"
status_style_file="$recording_dir/.oc-record.status-style"
lock_file="$recording_dir/.oc-record.lock"
log_file="$recording_dir/.oc-record.log"
model_dir="/tmp/whisper.cpp"
model="$model_dir/ggml-small.bin"
model_url="https://huggingface.co/ggerganov/whisper.cpp/resolve/5359861c739e955e79d9a303bcbc70fb988958b1/ggml-small.bin"
model_sha256="1be3a9b2063867b937e64e2ec7483364a79917e157fa98c5d94b5c1fffea987b"
language="${OC_RECORD_LANGUAGE:-auto}"

message() {
  if ! tmux display-message -t "$pane" "$1" 2>>"$log_file"; then
    printf '%s\n' "$1" >&2
  fi
}

restore_status_style() {
  local status_style=""

  if [ -s "$status_style_file" ]; then
    IFS= read -r status_style <"$status_style_file" || true
    if [ -n "$status_style" ]; then
      tmux set-option -t "$pane" status-style "$status_style" 2>>"$log_file" \
        || true
    fi
    rm -f "$status_style_file"
  fi
}

mkdir -p "$recording_dir"
exec 9>"$lock_file"
flock 9

# A valid state identifies the only process this command may signal. Partial or
# stale state is disposable because the recording directory itself is temporary.
if [ -s "$state_file" ]; then
  IFS=$'\t' read -r pid output <"$state_file" || true

  if [[ "$pid" =~ ^[0-9]+$ ]] \
    && [[ "$output" == "$recording_dir/"*.wav ]] \
    && grep -Ezxq '(.*/)?ffmpeg' "/proc/$pid/cmdline" 2>/dev/null \
    && grep -Fzxq -- "$output" "/proc/$pid/cmdline" 2>/dev/null; then
    kill -INT "$pid" 2>/dev/null || true

    for _ in {1..50}; do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.1
    done

    if kill -0 "$pid" 2>/dev/null; then
      message "Microphone recording did not stop; try again"
      exit 1
    fi

    rm -f "$state_file" "$log_file"
    restore_status_style
    transcript="${output%.wav}.txt"

    if [ ! -f "$model" ]; then
      mkdir -p "$model_dir"
      model_tmp="$(mktemp "$model_dir/ggml-small.bin.XXXXXX")"
      message "Microphone recording saved; downloading Whisper model"

      if ! curl -fL "$model_url" -o "$model_tmp" 2>"$log_file"; then
        rm -f "$model_tmp"
        message "Recording saved but Whisper model download failed; check $log_file"
        exit 1
      fi

      if ! printf '%s  %s\n' "$model_sha256" "$model_tmp" \
        | sha256sum -c - >>"$log_file" 2>&1; then
        rm -f "$model_tmp"
        message "Recording saved but Whisper model verification failed; check $log_file"
        exit 1
      fi

      if ! mv "$model_tmp" "$model" 2>>"$log_file"; then
        rm -f "$model_tmp"
        message "Recording saved but Whisper model installation failed; check $log_file"
        exit 1
      fi
    fi

    rm -f "$transcript"
    message "Microphone recording saved; transcribing"
    if ! whisper-cli \
      --model "$model" \
      --file "$output" \
      --language "$language" \
      --output-txt \
      --output-file "${output%.wav}" \
      </dev/null >>"$log_file" 2>&1; then
      rm -f "$transcript"
      message "Recording saved but transcription failed; check $log_file"
      exit 1
    fi

    # A rapid start-stop can produce a valid WAV header without audio frames.
    # whisper-cli returns success without creating output, so represent that
    # successful empty recording with an empty transcript.
    [ -f "$transcript" ] || : >"$transcript"

    transcript_text="$(<"$transcript")"
    while [[ "$transcript_text" == *$'\r' || "$transcript_text" == *$'\n' ]]; do
      transcript_text="${transcript_text%?}"
    done

    if [ -n "$transcript_text" ]; then
      buffer_name="oc-record-transcript-$$"
      if ! tmux set-buffer -b "$buffer_name" -- "$transcript_text" 2>>"$log_file"; then
        message "Recording and transcript saved but tmux buffer creation failed; check $log_file"
        exit 1
      fi

      if ! tmux paste-buffer -p -r -d -b "$buffer_name" -t "$pane" 2>>"$log_file"; then
        tmux delete-buffer -b "$buffer_name" 2>>"$log_file" || true
        message "Recording and transcript saved but pane insertion failed; check $log_file"
        exit 1
      fi
    fi

    rm -f "$log_file"
    if [ -n "$transcript_text" ]; then
      message "Microphone recording saved: $output; transcript inserted without submitting: $transcript"
    else
      message "Microphone recording saved: $output; transcript is empty: $transcript"
    fi
    exit 0
  fi

  rm -f "$state_file"
  restore_status_style
fi

# Recover the session style when a prior recorder disappeared before its state
# could be cleaned. The new recording then captures the recovered base style.
restore_status_style

output="$recording_dir/$(date +%Y%m%d-%H%M%S).wav"
tmux show-options -A -t "$pane" -v status-style >"$status_style_file"
tmux set-option -t "$pane" status-style "bg=yellow,fg=black"

PULSE_SERVER=tcp:127.0.0.1:47130 \
  ffmpeg -nostdin -hide_banner -loglevel error \
    -f pulse -i default \
    -ac 1 -ar 48000 -c:a pcm_s16le \
    "$output" \
    9>&- </dev/null 2>"$log_file" &

pid="$!"
sleep 0.2

if ! kill -0 "$pid" 2>/dev/null; then
  wait "$pid" 2>/dev/null || true
  rm -f "$output"
  restore_status_style
  message "Microphone recording failed; check $log_file"
  exit 1
fi

printf '%s\t%s\n' "$pid" "$output" >"$state_file"
message "Microphone recording started: $output"
